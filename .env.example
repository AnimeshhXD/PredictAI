# ── LLM provider settings ──────────────────────────────────────────────────────
# Choose one of: openai | anthropic | google
LLM_PROVIDER=openai

# Model name — must match the chosen provider's API
# openai:     gpt-4o | gpt-4o-mini | gpt-3.5-turbo
# anthropic:  claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
# google:     gemini-1.5-pro | gemini-1.5-flash
LLM_MODEL=gpt-4o-mini

# ── API keys (fill in exactly one block) ───────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ── LLM tuning ────────────────────────────────────────────────────────────────
# Max tokens returned per LLM call
LLM_MAX_TOKENS=2048

# Directory for prompt-hash → response disk cache (relative to project root)
LLM_CACHE_DIR=.llm_cache

# ── Kaggle credentials (for 'make data' / M5 download) ────────────────────────
# Alternative to ~/.kaggle/kaggle.json — set here if you prefer env vars.
# See: https://www.kaggle.com/docs/api
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Experiment settings ────────────────────────────────────────────────────────
# Global random seed for reproducibility
RANDOM_SEED=42

# M5 cutoff date for the primary what-if evaluation window
M5_CUTOFF_DATE=2016-04-25

# Forecast horizon in days
HORIZON_DAYS=28

# Fraction of data used for held-out test evaluation (after cutoff)
TEST_FRACTION=0.1
