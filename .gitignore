# ── Secrets (NEVER commit) ─────────────────────────────────────────────────────
.env
.env.local

# ── LLM prompt cache ───────────────────────────────────────────────────────────
.llm_cache/

# ── Python bytecode ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Test / coverage artefacts ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
results/coverage_html/

# ── Data files (too large for git; download via 'make data') ──────────────────
data/raw/
data/processed/

# ── Results & Figures (Paper Tables and Summaries tracked) ─────────────────
results/*.parquet
!results/*.csv
!results/summary.md
!results/figures/
!results/.gitkeep

# ── Notebooks output ───────────────────────────────────────────────────────────
notebooks/.ipynb_checkpoints/

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
